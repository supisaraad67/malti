        function hexToRgb(hex) {
            let r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16);
            return [r, g, b];
        }

        function getLuminance(r, g, b) {
            let [rs, gs, bs] = [r/255, g/255, b/255].map(c => {
                return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
            });
            return 0.2126 * rs + 0.7152 * gs + 0.0722 * bs;
        }

        function updateColorStation() {
            const { text, bg, size, bold } = state.color;
            
            document.getElementById('val-tcolor').textContent = text;
            document.getElementById('val-bgcolor').textContent = bg;
            document.getElementById('val-tsize').textContent = `${size} px`;
            
            const pbox = document.getElementById('preview-text-box');
            const ptext = document.getElementById('preview-text');
            pbox.style.backgroundColor = bg;
            ptext.style.color = text;
            ptext.style.fontSize = `${size}px`;
            ptext.style.fontWeight = bold ? 'bold' : 'normal';

            const rgbT = hexToRgb(text);
            const rgbB = hexToRgb(bg);
            const lT = getLuminance(...rgbT);
            const lB = getLuminance(...rgbB);
            const lighter = Math.max(lT, lB);
            const darker = Math.min(lT, lB);
            const ratio = (lighter + 0.05) / (darker + 0.05);

            document.getElementById('val-contrast').textContent = `${ratio.toFixed(2)}:1`;

            const isLarge = size >= 24 || (size >= 18.66 && bold);
            const passAAN = ratio >= 4.5;
            const passAAL = ratio >= 3.0;
            const passAAAN = ratio >= 7.0;

            const tN = document.getElementById('tag-aa-normal');
            tN.className = 'tag ' + (passAAN ? 'pass' : '');
            tN.textContent = passAAN ? 'AA ปกติ (ผ่าน)' : 'AA ปกติ (ตก)';

            const tL = document.getElementById('tag-aa-large');
            tL.className = 'tag ' + (passAAL ? 'pass' : '');
            tL.textContent = passAAL ? 'AA ใหญ่ (ผ่าน)' : 'AA ใหญ่ (ตก)';

            const tA = document.getElementById('tag-aaa-normal');
            tA.className = 'tag ' + (passAAAN ? 'pass' : '');
            tA.textContent = passAAAN ? 'AAA ปกติ (ผ่าน)' : 'AAA ปกติ (ตก)';

            // Mission: size <= 18, !bold, pass 4.5
            if (size <= 18 && !bold && ratio >= 4.5 && !state.missions[0]) {
                state.missions[0] = true;
                saveProgress();
            } else if ((size > 18 || bold || ratio < 4.5) && state.missions[0]) {
                // If they change it back to failing, optionally remove badge. Let's keep it forgiving and let them keep it once earned.
                // Or to be strict:
                // state.missions[0] = false;
                // saveProgress();
            }
        }

        const offCanvas = document.createElement('canvas');
        offCanvas.width = 1280;
        offCanvas.height = 720;
        const offCtx = offCanvas.getContext('2d', { willReadFrequently: true });

        const workCanvas = document.createElement('canvas');
        const workCtx = workCanvas.getContext('2d', { willReadFrequently: true });

        function renderBaseScenery() {
            const ctx = offCtx;
            // Sky gradient
            const grad = ctx.createLinearGradient(0, 0, 0, 720);
            grad.addColorStop(0, '#87CEEB');
            grad.addColorStop(1, '#f0f8ff');
            ctx.fillStyle = grad;
            ctx.fillRect(0, 0, 1280, 720);

            // Sun
            ctx.fillStyle = '#FFD700';
            ctx.beginPath();
            ctx.arc(1000, 200, 80, 0, Math.PI * 2);
            ctx.fill();

            // Mountains
            ctx.fillStyle = '#4b5563';
            ctx.beginPath();
            ctx.moveTo(0, 720);
            ctx.lineTo(300, 300);
            ctx.lineTo(600, 720);
            ctx.fill();

            ctx.fillStyle = '#374151';
            ctx.beginPath();
            ctx.moveTo(400, 720);
            ctx.lineTo(800, 200);
            ctx.lineTo(1280, 720);
            ctx.fill();

            // Details (lines to show pixelation)
            ctx.strokeStyle = '#1f2937';
            ctx.lineWidth = 2;
            for(let i=0; i<20; i++) {
                ctx.beginPath();
                ctx.moveTo(400 + i*10, 720);
                ctx.lineTo(800 + i*10, 200 + i*15);
                ctx.stroke();
            }
        }

        function updateImgStation() {
            const { res, bit } = state.img;
            document.getElementById('val-imgo-res').textContent = `${res}%`;
            document.getElementById('val-img-bit').textContent = `${bit} bit`;
            document.getElementById('val-img-totalbit').textContent = bit * 3;

            const baseW = 1280;
            const baseH = 720;
            const w = Math.max(1, Math.floor(baseW * (res / 100)));
            const h = Math.max(1, Math.floor(baseH * (res / 100)));

            document.getElementById('val-img-dim').textContent = `${w} x ${h}`;
            
            const totalBits = bit * 3;
            const colors = Math.pow(2, totalBits);
            document.getElementById('val-img-colors').textContent = colors.toLocaleString();
            
            const rawSize = (w * h * totalBits) / 8;
            document.getElementById('val-img-size').textContent = `${rawSize.toLocaleString()} Bytes`;

            // Mission: raw < 1MB, bit == 8, w >= 640
            if (rawSize < 1048576 && bit === 8 && w >= 640 && !state.missions[1]) {
                state.missions[1] = true;
                saveProgress();
            }

            // Draw to main canvas
            const mainCanvas = document.getElementById('canvas-img');
            const mainCtx = mainCanvas.getContext('2d');
            
            // 1. Draw scaled down version to work canvas
            workCanvas.width = w;
            workCanvas.height = h;
            workCtx.drawImage(offCanvas, 0, 0, w, h);

            // 2. Apply bit depth (Posterization) IF bits < 8
            if (bit < 8) {
                const imgData = workCtx.getImageData(0, 0, w, h);
                const data = imgData.data;
                const levels = Math.pow(2, bit);
                const step = 255 / (levels - 1);
                
                for (let i = 0; i < data.length; i += 4) {
                    data[i] = Math.round(data[i] / step) * step;     // R
                    data[i+1] = Math.round(data[i+1] / step) * step; // G
                    data[i+2] = Math.round(data[i+2] / step) * step; // B
                }
                workCtx.putImageData(imgData, 0, 0);
            }

            // 3. Draw back to main canvas with Nearest Neighbor to show pixelation
            mainCtx.imageSmoothingEnabled = false;
            mainCtx.clearRect(0, 0, baseW, baseH);
            mainCtx.drawImage(workCanvas, 0, 0, baseW, baseH);
        }

        function updateMixer() {
            const { r, g, b } = state.img.mix;
            const hex = "#" + (1 << 24 | r << 16 | g << 8 | b).toString(16).slice(1);
            document.getElementById('mix-preview').style.backgroundColor = hex;
            document.getElementById('mix-hex').textContent = hex;
        }

        let audioCtx;
        function updateAudStation() {
            const { rate, bit } = state.aud;
            document.getElementById('val-aud-rate').textContent = `${rate} Hz`;
            document.getElementById('val-aud-bit').textContent = `${bit} bit`;
            
            const nyquistPass = rate > (440 * 2);
            const tagN = document.getElementById('tag-nyquist');
            tagN.className = 'tag ' + (nyquistPass ? 'pass' : '');
            tagN.textContent = nyquistPass ? 'ผ่าน' : 'ไม่ผ่าน (Aliasing)';

            const levels = Math.pow(2, bit);
            document.getElementById('val-aud-levels').textContent = levels.toLocaleString();

            const kbps = (rate * bit / 8) / 1000;
            document.getElementById('val-aud-size').textContent = `${kbps.toFixed(2)} KB/s`;

            // Mission: Nyquist true, bit >= 8, kbps <= 20
            if (nyquistPass && bit >= 8 && kbps <= 20 && !state.missions[2]) {
                state.missions[2] = true;
                saveProgress();
            }

            drawAudioWave();
        }

        function drawAudioWave() {
            const canvas = document.getElementById('canvas-audio');
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;
            const { rate, bit } = state.aud;

            ctx.clearRect(0, 0, w, h);
            
            const freq = 440;
            const duration = 2 / freq; // 2 periods
            const levels = Math.pow(2, bit);
            const maxLevel = levels - 1;

            // Draw center line
            ctx.strokeStyle = '#9ca3af';
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(0, h/2); ctx.lineTo(w, h/2); ctx.stroke();

            // Draw ideal wave
            ctx.strokeStyle = '#e5e7eb';
            ctx.lineWidth = 3;
            ctx.beginPath();
            for(let x=0; x<w; x++) {
                let t = (x / w) * duration;
                let val = Math.sin(2 * Math.PI * freq * t);
                let y = h/2 - (val * h/2.2);
                if(x===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
            }
            ctx.stroke();

            // Draw sampled/quantized wave
            const numSamples = Math.floor(rate * duration);
            if (numSamples < 1000) { // Safety limit for rendering
                ctx.strokeStyle = '#ef4444'; // Red stems
                ctx.fillStyle = '#ef4444';
                ctx.lineWidth = 1;

                let prevQuantY = -1;
                let prevX = 0;

                ctx.beginPath(); // For steps (thick blue line)
                ctx.strokeStyle = '#3b82f6';
                ctx.lineWidth = 3;

                for(let i=0; i<=numSamples; i++) {
                    let t = i / rate;
                    let x = (t / duration) * w;
                    if (x > w) break;

                    let rawVal = Math.sin(2 * Math.PI * freq * t);
                    
                    // Quantize
                    let norm = (rawVal + 1) / 2; // 0 to 1
                    let quantNorm = Math.round(norm * maxLevel) / maxLevel;
                    let quantVal = (quantNorm * 2) - 1;
                    
                    let y = h/2 - (quantVal * h/2.2);
                    
                    // Draw stems (only if few samples so it's readable)
                    if (numSamples <= 100) {
                        let origCtx = ctx.strokeStyle;
                        ctx.strokeStyle = '#fca5a5';
                        ctx.lineWidth = 1;
                        ctx.beginPath(); ctx.moveTo(x, h/2); ctx.lineTo(x, y); ctx.stroke();
                        ctx.beginPath(); ctx.arc(x, y, 3, 0, Math.PI*2); ctx.fill();
                        ctx.strokeStyle = origCtx;
                    }

                    // Draw step wave
                    if (i === 0) {
                        ctx.moveTo(x, y);
                    } else {
                        ctx.lineTo(x, prevQuantY); // Horizontal step
                        ctx.lineTo(x, y);          // Vertical step
                    }
                    prevQuantY = y;
                    prevX = x;
                }
                ctx.lineTo(w, prevQuantY);
                ctx.stroke();
            }
        }

        async function playAudio() {
            const alertBox = document.getElementById('audio-alert');
            alertBox.style.display = 'none';

            if (state.aud.rate < 8000) {
                alertBox.textContent = 'ไม่สามารถเล่นเสียงได้: อัตราสุ่ม (Sample Rate) ต่ำกว่า 8000 Hz ซึ่ง Web Audio API ไม่รองรับ';
                alertBox.style.display = 'block';
                return;
            }

            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                if (audioCtx.state === 'suspended') await audioCtx.resume();

                // Create buffer with selected sample rate
                const rate = state.aud.rate;
                const buffer = audioCtx.createBuffer(1, rate, rate); // 1 sec, mono
                const data = buffer.getChannelData(0);
                
                const freq = 440;
                const levels = Math.pow(2, state.aud.bit);
                const maxLevel = levels - 1;

                for (let i = 0; i < rate; i++) {
                    let rawVal = Math.sin(2 * Math.PI * freq * (i / rate));
                    let norm = (rawVal + 1) / 2;
                    let quantNorm = Math.round(norm * maxLevel) / maxLevel;
                    // Lower volume by 0.1 factor to protect ears
                    data[i] = ((quantNorm * 2) - 1) * 0.1;
                }

                const source = audioCtx.createBufferSource();
                source.buffer = buffer;
                source.connect(audioCtx.destination);
                source.start();
            } catch (e) {
                alertBox.textContent = 'บราวเซอร์ไม่รองรับ หรือไม่อนุญาตให้เล่นเสียง';
                alertBox.style.display = 'block';
                console.error(e);
            }
        }

        let lastVidFrameTime = 0;
        let ballX = 0, ballY = 150, ballVX = 150, ballVY = 0; // units/sec
        
        function updateVidStation() {
            const { fps, comp } = state.vid;
            document.getElementById('val-vid-fps').textContent = `${fps} FPS`;
            
            // Logarithmic compression scale: 0->1, 100->300
            // ratio = 10^(comp/100 * log10(300))
            const maxRatio = 300;
            let ratio = 1;
            if (comp > 0) {
                ratio = Math.pow(10, (comp / 100) * Math.log10(maxRatio));
            }
            
            document.getElementById('val-vid-comp').textContent = `1:${ratio.toFixed(0)}`;

            const rawBps = 1280 * 720 * 3 * fps * 8;
            const rawMbps = rawBps / 1000000;
            document.getElementById('val-vid-raw').textContent = `${rawMbps.toFixed(2)} Mbit/s`;

            const compMbps = rawMbps / ratio;
            document.getElementById('val-vid-bitrate').textContent = `${compMbps.toFixed(2)} Mbit/s`;

            const sizeMb = (compMbps * 60) / 8;
            document.getElementById('val-vid-size').textContent = `${sizeMb.toFixed(2)} MB`;

            // Mission: compMbps <= 5, fps >= 24
            if (compMbps <= 5 && fps >= 24 && !state.missions[3]) {
                state.missions[3] = true;
                saveProgress();
            }
        }

        function videoLoop(timestamp) {
            if (state.reducedMotion) {
                drawVideoFrame(timestamp, true);
                requestAnimationFrame(videoLoop);
                return;
            }

            const { fps } = state.vid;
            const frameTime = 1000 / fps;
            
            // Physics update independent of frame rate
            if (!lastVidFrameTime) lastVidFrameTime = timestamp;
            const dt = (timestamp - lastVidFrameTime) / 1000; // in seconds
            
            // Limit dt to prevent huge jumps if tab is backgrounded
            if (dt < 0.1) {
                ballX += ballVX * dt;
                ballVY += 500 * dt; // gravity
                ballY += ballVY * dt;

                if (ballX > 600 - 20) { ballX = 600 - 20; ballVX *= -1; }
                if (ballX < 20) { ballX = 20; ballVX *= -1; }
                if (ballY > 300 - 20) { ballY = 300 - 20; ballVY *= -0.8; }
            }

            // Draw based on selected FPS (Throttle rendering)
            if (timestamp - lastVidFrameTime >= frameTime) {
                drawVideoFrame(timestamp);
                lastVidFrameTime = timestamp; // Note: accurate throttling would subtract remainder, but simple assign is fine here
            }

            requestAnimationFrame(videoLoop);
        }

        let frameCounter = 0;
        function drawVideoFrame(timestamp, isStatic = false) {
            const canvas = document.getElementById('canvas-video');
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;

            ctx.fillStyle = '#222';
            ctx.fillRect(0, 0, w, h);

            if (isStatic) {
                ctx.fillStyle = '#fff';
                ctx.font = '20px sans-serif';
                ctx.fillText('Reduced Motion Activated', 50, 150);
                return;
            }

            // Draw Ball
            ctx.fillStyle = '#3b82f6';
            ctx.beginPath();
            ctx.arc(ballX, ballY, 20, 0, Math.PI*2);
            ctx.fill();

            // Info text
            frameCounter++;
            ctx.fillStyle = '#fff';
            ctx.font = '16px monospace';
            ctx.fillText(`Frame: ${frameCounter}`, 10, 20);
            ctx.fillText(`FPS Target: ${state.vid.fps}`, 10, 40);
            
            // Ghosting effect to show low FPS judder conceptually
            if (state.vid.fps < 30) {
                ctx.fillStyle = 'rgba(59, 130, 246, 0.3)';
                ctx.beginPath();
                ctx.arc(ballX - ballVX*0.05, ballY - ballVY*0.05, 20, 0, Math.PI*2);
                ctx.fill();
            }
        }

        function buildQuiz() {
            const container = document.getElementById('quiz-container');
            container.innerHTML = '';
            
            QUIZ_DATA.forEach((q, idx) => {
                const item = document.createElement('div');
                item.className = 'quiz-item';
                
                const title = document.createElement('h3');
                title.textContent = `ข้อที่ ${idx + 1}: ${q.q}`;
                item.appendChild(title);

                const optsDiv = document.createElement('div');
                optsDiv.className = 'quiz-options';

                q.options.forEach((optText, optIdx) => {
                    const btn = document.createElement('button');
                    btn.className = 'quiz-btn';
                    btn.textContent = optText;
                    
                    // Restore state
                    if (state.quiz[idx] === optIdx) {
                        btn.classList.add('selected');
                        if (optIdx === q.ans) btn.classList.add('correct');
                        else btn.classList.add('wrong');
                    }

                    btn.onclick = () => handleQuizAns(idx, optIdx, item);
                    optsDiv.appendChild(btn);
                });

                const feedback = document.createElement('div');
                feedback.className = 'feedback';
                feedback.id = `feedback-${idx}`;
                
                if (state.quiz[idx] !== null) {
                    feedback.classList.add('show');
                    feedback.textContent = q.exp;
                    if (state.quiz[idx] === q.ans) {
                        feedback.style.backgroundColor = 'rgba(16, 185, 129, 0.1)';
                        feedback.style.color = 'var(--success)';
                    } else {
                        feedback.style.backgroundColor = 'rgba(239, 68, 68, 0.1)';
                        feedback.style.color = 'var(--danger)';
                    }
                }

                item.appendChild(optsDiv);
                item.appendChild(feedback);
                container.appendChild(item);
            });
        }

        function handleQuizAns(qIdx, optIdx, itemNode) {
            state.quiz[qIdx] = optIdx;
            
            // Update UI
            const btns = itemNode.querySelectorAll('.quiz-btn');
            btns.forEach((b, i) => {
                b.className = 'quiz-btn'; // reset
                if (i === optIdx) {
                    b.classList.add('selected');
                    b.classList.add(i === QUIZ_DATA[qIdx].ans ? 'correct' : 'wrong');
                }
            });

            const feedback = itemNode.querySelector('.feedback');
            feedback.classList.add('show');
            feedback.textContent = QUIZ_DATA[qIdx].exp;
            if (optIdx === QUIZ_DATA[qIdx].ans) {
                feedback.style.backgroundColor = 'rgba(16, 185, 129, 0.1)';
                feedback.style.color = 'var(--success)';
            } else {
                feedback.style.backgroundColor = 'rgba(239, 68, 68, 0.1)';
                feedback.style.color = 'var(--danger)';
            }

            saveProgress();
            checkQuizMission();
        }

        function checkQuizMission() {
            let allCorrect = true;
            for(let i=0; i<5; i++) {
                if (state.quiz[i] !== QUIZ_DATA[i].ans) {
                    allCorrect = false;
                    break;
                }
            }
            if (allCorrect && !state.missions[4]) {
                state.missions[4] = true;
                saveProgress();
            }
        }

        // Run
        window.onload = init;
    </script>
</body>
